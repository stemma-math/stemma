# Written by `stemma`; `stemma upgrade` writes it again. The checks a pull
# request must pass to be merged are its two jobs, both required:
#
# - `Stemma verify`: signatures and approvals, checked against the members'
#   keys in stemma.toml on main. It builds nothing, so it answers in a minute.
# - `Stemma check`: the build and every rule of the specification.
#
# Both read only the repository: nothing here depends on the forge's secrets.
# Pull requests restore what main built (the dependencies, Mathlib among
# them, and the library's own build), and only main saves it, so that pull
# requests never evict main's caches.
#
# For Forgejo: the jobs run on the runners labelled {{ runner }} (`[forge]
# runner` in stemma.toml), and actions come from data.forgejo.org, so that
# they are found on any instance.
name: Stemma

on:
  pull_request:
  push:
    branches: [main]

jobs:
  verify:
    name: Stemma verify
    runs-on: {{ runner }}
    steps:
      - uses: https://data.forgejo.org/actions/checkout@v4
        with:
          # `stemma verify` reads the commits of the change and of main.
          fetch-depth: 0
      - name: Install stemma
        run: |
          version=$(sed -n 's/^stemma = "\(.*\)"$/\1/p' stemma.toml)
          name="stemma-$version-x86_64-unknown-linux-musl"
          curl -sSfL "https://github.com/stemma-math/stemma/releases/download/v$version/$name.tar.gz" | tar xz
          echo "$PWD/$name" >> "$GITHUB_PATH"
      - name: Verify
        run: stemma verify --no-build

  check:
    name: Stemma check
    runs-on: {{ runner }}
    steps:
      - uses: https://data.forgejo.org/actions/checkout@v4
        with:
          # `stemma check` reads the policy from main.
          fetch-depth: 0
      - name: Install elan
        run: |
          curl -sSfL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh \
            | sh -s -- -y --default-toolchain none
          echo "$HOME/.elan/bin" >> "$GITHUB_PATH"
      - name: Install stemma
        run: |
          version=$(sed -n 's/^stemma = "\(.*\)"$/\1/p' stemma.toml)
          name="stemma-$version-x86_64-unknown-linux-musl"
          curl -sSfL "https://github.com/stemma-math/stemma/releases/download/v$version/$name.tar.gz" | tar xz
          echo "$PWD/$name" >> "$GITHUB_PATH"
{%- raw %}
      # The dependencies (Stemma's Lean package, Verso, Mathlib and theirs),
      # built, for exactly these versions.
      - name: Restore the dependencies
        id: dependencies
        uses: https://data.forgejo.org/actions/cache/restore@v4
        with:
          path: .lake/packages
          key: stemma-dependencies-${{ runner.os }}-${{ hashFiles('lean-toolchain', 'lake-manifest.json') }}
      # The library's own build, from the latest run on main.
      - name: Restore the library's build
        uses: https://data.forgejo.org/actions/cache/restore@v4
        with:
          path: .lake/build
          key: stemma-build-${{ runner.os }}-${{ hashFiles('lean-toolchain', 'lake-manifest.json') }}-${{ github.sha }}
          restore-keys: stemma-build-${{ runner.os }}-${{ hashFiles('lean-toolchain', 'lake-manifest.json') }}-
      - name: Build the dependencies
        if: steps.dependencies.outputs.cache-hit != 'true'
        run: |
          if grep -q 'name = "mathlib"' lakefile.toml; then
            lake exe cache get
          fi
          lake build @stemma/Stemma @stemma/stemma-extract
      # Saved before checking, so that a check that fails keeps them.
      - name: Save the dependencies
        if: steps.dependencies.outputs.cache-hit != 'true' && github.event_name == 'push'
        uses: https://data.forgejo.org/actions/cache/save@v4
        with:
          path: .lake/packages
          key: ${{ steps.dependencies.outputs.cache-primary-key }}
      - name: Check
        run: stemma check
      - name: Save the library's build
        if: ${{ !cancelled() && github.event_name == 'push' }}
        uses: https://data.forgejo.org/actions/cache/save@v4
        with:
          path: .lake/build
          key: stemma-build-${{ runner.os }}-${{ hashFiles('lean-toolchain', 'lake-manifest.json') }}-${{ github.sha }}
      # The site: on pull requests, a downloadable artifact; it never fails
      # the check. Forgejo has no Pages, so nothing is published.
      - name: Build the site
        id: site
        if: github.event_name == 'pull_request'
        continue-on-error: true
        run: |
          pages=$(stemma preview --no-serve --json | sed -n 's/.*"pages":"\([^"]*\)".*/\1/p')
          cp -r "$pages" _site
      - name: Upload the site
        if: github.event_name == 'pull_request' && steps.site.outcome == 'success'
        uses: https://data.forgejo.org/forgejo/upload-artifact@v4
        with:
          name: site
          path: _site
{%- endraw %}
