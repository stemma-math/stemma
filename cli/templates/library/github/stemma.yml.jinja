{% raw -%}
# Written by `stemma`; `stemma upgrade` writes it again. The checks a pull
# request must pass to be merged are its two jobs, both required:
#
# - `Stemma verify`: signatures and approvals, checked against the members'
#   keys in stemma.toml on main. It builds nothing, so it answers in a minute.
# - `Stemma check`: the build and every rule of the specification.
#
# Both read only the repository: nothing here depends on the forge's secrets.
# Pull requests restore what main built (the dependencies and the library's
# own build), and only main saves it, so that pull requests never evict
# main's caches. Mathlib's build is not cached here: `lake exe cache get`
# downloads it, and the runner's disk cannot hold it twice.
name: Stemma

on:
  pull_request:
  push:
    branches: [main]

permissions:
  contents: read

concurrency:
  group: stemma-${{ github.ref }}
  # A run on main always finishes, so that it saves its caches.
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}

jobs:
  verify:
    name: Stemma verify
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
        with:
          # `stemma verify` reads the commits of the change and of main.
          fetch-depth: 0
      - name: Install stemma
        run: |
          version=$(sed -n 's/^stemma = "\(.*\)"$/\1/p' stemma.toml)
          name="stemma-$version-x86_64-unknown-linux-musl"
          curl -sSfL "https://github.com/stemma-math/stemma-signum/releases/download/v$version/$name.tar.gz" | tar xz
          echo "$PWD/$name" >> "$GITHUB_PATH"
      - name: Verify
        run: stemma verify --no-build

  check:
    name: Stemma check
    runs-on: ubuntu-latest
    env:
      # The dependencies (Stemma's Lean package, Verso, Mathlib and theirs),
      # checked out and built, but for Mathlib's own build. A listed directory
      # is cached whole, so Mathlib's is listed entry by entry: its checkout,
      # and the program and build of `lake exe cache`.
      STEMMA_CACHE_DEPENDENCIES: |
        .lake/packages/*
        !.lake/packages/mathlib
        .lake/packages/mathlib/*
        !.lake/packages/mathlib/.lake
        .lake/packages/mathlib/.lake/build/bin
        .lake/packages/mathlib/.lake/build/ir/Cache
        .lake/packages/mathlib/.lake/build/lib/lean/Cache
      # The library's build, and the native code of the dependencies that the
      # site's program links, which grows with what the library imports.
      STEMMA_CACHE_BUILD: |
        .lake/build
        .lake/packages/*/.lake/build/ir/**/*.c.o.*
    steps:
      # Mathlib leaves the runner's disk too full to write a cache's archive.
      # The toolchains of Android, .NET and Haskell, which nothing here uses,
      # are removed in the background while the job goes on.
      - name: Make room on the disk
        run: |
          sudo nohup rm -rf /usr/local/lib/android /usr/share/dotnet /opt/ghc /usr/local/.ghcup \
            > /dev/null 2>&1 &
      - uses: actions/checkout@v5
        with:
          # `stemma check` reads the policy from main.
          fetch-depth: 0
      - name: Install elan
        run: |
          curl -sSfL https://raw.githubusercontent.com/leanprover/elan/master/elan-init.sh \
            | sh -s -- -y --default-toolchain none
          echo "$HOME/.elan/bin" >> "$GITHUB_PATH"
      - name: Install stemma
        run: |
          version=$(sed -n 's/^stemma = "\(.*\)"$/\1/p' stemma.toml)
          name="stemma-$version-x86_64-unknown-linux-musl"
          curl -sSfL "https://github.com/stemma-math/stemma-signum/releases/download/v$version/$name.tar.gz" | tar xz
          echo "$PWD/$name" >> "$GITHUB_PATH"
      # For exactly these versions of Lean and of the dependencies.
      - name: Restore the dependencies
        id: dependencies
        uses: actions/cache/restore@v5
        with:
          path: ${{ env.STEMMA_CACHE_DEPENDENCIES }}
          key: stemma-dependencies-${{ runner.os }}-${{ hashFiles('lean-toolchain', 'lake-manifest.json') }}
      # From the latest run on main.
      - name: Restore the library's build
        uses: actions/cache/restore@v5
        with:
          path: ${{ env.STEMMA_CACHE_BUILD }}
          key: stemma-build-${{ runner.os }}-${{ hashFiles('lean-toolchain', 'lake-manifest.json') }}-${{ github.sha }}
          restore-keys: stemma-build-${{ runner.os }}-${{ hashFiles('lean-toolchain', 'lake-manifest.json') }}-
      # With the dependencies restored, this only downloads Mathlib's build.
      - name: Build the dependencies
        run: |
          if grep -q 'name = "mathlib"' lakefile.toml; then
            lake exe cache get
          fi
          lake build @stemma/Stemma @stemma/stemma-extract
      # Saved before checking, so that a check that fails keeps them.
      - name: Save the dependencies
        if: steps.dependencies.outputs.cache-hit != 'true' && github.event_name == 'push'
        uses: actions/cache/save@v5
        with:
          path: ${{ env.STEMMA_CACHE_DEPENDENCIES }}
          key: ${{ steps.dependencies.outputs.cache-primary-key }}
      - name: Check
        run: stemma check
      # The site: on pull requests, a downloadable artifact. Main builds it
      # too, so that its caches hold the native code the site links.
      - name: Build the site
        id: site
{%- endraw %}
{%- if publish %}
        continue-on-error: {% raw %}${{ github.event_name == 'pull_request' }}{% endraw %}
{%- else %}
        continue-on-error: true
{%- endif %}
{%- raw %}
        run: |
          pages=$(stemma preview --no-serve --json | jq -r .pages)
          cp -r "$pages" _site
      - name: Upload the site
        if: github.event_name == 'pull_request' && steps.site.outcome == 'success'
        uses: actions/upload-artifact@v7
        with:
          name: site
          path: _site
      - name: Save the library's build
        if: ${{ !cancelled() && github.event_name == 'push' }}
        uses: actions/cache/save@v5
        with:
          path: ${{ env.STEMMA_CACHE_BUILD }}
          key: stemma-build-${{ runner.os }}-${{ hashFiles('lean-toolchain', 'lake-manifest.json') }}-${{ github.sha }}
{%- endraw %}
{%- if publish %}
{%- raw %}
      # `[site] publish = true` in stemma.toml: main's site goes to GitHub Pages.
      - name: Upload the site for GitHub Pages
        if: github.event_name == 'push'
        uses: actions/upload-pages-artifact@v5
        with:
          path: _site

  publish:
    name: Publish the site
    needs: check
    if: github.event_name == 'push' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v5
{%- endraw %}
{%- endif %}
