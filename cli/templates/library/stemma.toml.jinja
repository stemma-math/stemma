[library]
name = "{{ name }}"
title = "{{ title }}"
stemma = "{{ version }}"

# The group's members, their roles, and the public keys they sign with.
[members]
{%- for member in members %}
{{ member.name | tojson }} = { roles = ["maintainer", "signer"], keys = {{ member.keys | tojson }} }
{%- endfor %}

# What the library requires: every central environment carries a current
# signature, or `stemma check` fails.
[policy]
require_signed_central = true

# The library's site: whether the workflow publishes it to GitHub Pages, from
# main. Pull requests carry it as an artifact either way.
[site]
publish = {{ publish | tojson }}
